# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Gemini Flash (all extraction, classification, ranking) ---
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Optional: minimum gap between Gemini calls in ms (free tier is rate limited)
GEMINI_MIN_INTERVAL_MS=4000

# --- Gmail API (read Google Alerts / forwards, and send the digest if not using Brevo) ---
# Refresh token needs scopes: gmail.readonly + gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional: override the Gmail search used to find forwarded event emails
# GMAIL_FORWARD_QUERY=label:event-scout newer_than:7d

# --- Email sending ---
EMAIL_FROM="Event Scout <scout@example.com>"
VIKRAM_EMAIL=vikram@example.com
# Optional: send via Brevo (free tier) instead of Gmail
BREVO_API_KEY=

# --- App ---
# Public URL of the deployed dashboard (used for the digest link)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: protect the dashboard with HTTP basic auth (any username, this password)
DASHBOARD_PASSWORD=
# Optional: protects /api/cron/* (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
